---
/**
 * DealCard —— 首页 / 列表页用的「优惠卡片」。
 * 数据来自 src/data/deals.json，渲染时统一走 AffiliateLink 拼接追踪链接。
 */
import AffiliateLink from "./AffiliateLink.astro";
import PriceBlock from "./PriceBlock.astro";
import { gamePagePath } from "../config";
import type { Network } from "../config";

interface Deal {
  id: string;
  title: string;
  platform: string;
  network: Network;
  storeUrl: string;
  note: string;
  lastChecked: string;
  tags?: string[];
  image?: string;
  description?: string;
  price?: number;
  originalPrice?: number;
}

const { deal } = Astro.props as { deal: Deal };
const storeName =
  deal.network === "amazon"
    ? "Amazon"
    : deal.network === "gmg"
      ? "Green Man Gaming"
      : deal.network === "humble"
        ? "Humble Bundle"
        : "Fanatical";
const cover = deal.image ? deal.image : `/covers/${deal.id}.svg`;
const tags = (deal.tags || []).join(" ");
const isAmazon = deal.network === "amazon";
const detailUrl = gamePagePath(deal.id);
const desc =
  deal.description ||
  deal.note ||
  "Check the store for the latest price and edition details.";
---

<article class="deal-card" data-title={deal.title} data-platform={deal.platform} data-tags={tags}>
  <a class="cover-link" href={detailUrl} aria-label={deal.title}>
    <img class="cover" src={cover} alt={deal.title} width="140" height="187" loading="lazy" />
  </a>
  <div class="deal-head">
    <a class="title-link" href={detailUrl}><h3>{deal.title}</h3></a>
    <span class="platform">{deal.platform}</span>
  </div>
  <p class="desc">{desc}</p>
  <PriceBlock deal={deal} />
  <p class="note">{deal.note}</p>
  <AffiliateLink
    network={deal.network}
    href={deal.storeUrl}
    cta={isAmazon ? "Check price on Amazon" : `View on ${storeName}`}
  />
  <p class="checked">
    {isAmazon
      ? "Price varies on Amazon — tap to see the current deal."
      : `Last checked: ${deal.lastChecked} — verify price on store.`}
  </p>
</article>

<style>
  .deal-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.3rem;
  }
  .cover-link {
    display: block;
    width: 100%;
    max-width: 140px;
    margin: 0 auto 0.5rem;
    border-radius: 8px;
    overflow: hidden;
  }
  .cover {
    width: 100%;
    max-width: 140px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 8px;
    display: block;
    background: var(--border);
    transition: transform 0.15s ease;
  }
  .cover-link:hover .cover {
    transform: scale(1.03);
  }
  .deal-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    width: 100%;
  }
  .title-link {
    text-decoration: none;
    color: inherit;
  }
  .title-link:hover h3 {
    color: #1a73e8;
  }
  .deal-head h3 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .platform {
    font-size: 0.7rem;
    color: var(--muted);
    background: #eef1f4;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .desc {
    color: var(--text);
    font-size: 0.74rem;
    line-height: 1.45;
    margin: 0.25rem 0 0.35rem;
    text-align: left;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .note {
    color: var(--muted);
    font-size: 0.72rem;
    margin: 0.2rem 0 0.6rem;
    line-height: 1.4;
  }
  .checked {
    color: var(--muted);
    font-size: 0.68rem;
    margin: 0.5rem 0 0;
  }
</style>
