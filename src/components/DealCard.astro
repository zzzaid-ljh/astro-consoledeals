---
/**
 * DealCard —— 首页 / 列表页用的「优惠卡片」。
 * 数据来自 src/data/deals.json，渲染时统一走 AffiliateLink 拼接追踪链接。
 */
import AffiliateLink from "./AffiliateLink.astro";
import type { Network } from "../config";

interface Deal {
  id: string;
  title: string;
  platform: string;
  network: Network;
  storeUrl: string;
  note: string;
  lastChecked: string;
  tags?: string[];
  image?: string;
}

const { deal } = Astro.props as { deal: Deal };
const storeName =
  deal.network === "amazon"
    ? "Amazon"
    : deal.network === "gmg"
      ? "Green Man Gaming"
      : deal.network === "humble"
        ? "Humble Bundle"
        : "Fanatical";
const cover = deal.image ? deal.image : `/covers/${deal.id}.svg`;
const tags = (deal.tags || []).join(" ");
---

<article class="deal-card" data-title={deal.title} data-platform={deal.platform} data-tags={tags}>
  <img class="cover" src={cover} alt={deal.title} width="140" height="187" loading="lazy" />
  <div class="deal-head">
    <h3>{deal.title}</h3>
    <span class="platform">{deal.platform}</span>
  </div>
  <p class="note">{deal.note}</p>
  <AffiliateLink network={deal.network} href={deal.storeUrl} cta={`View on ${storeName}`} />
  <p class="checked">Last checked: {deal.lastChecked} — verify price on store.</p>
</article>

<style>
  .deal-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.3rem;
  }
  .cover {
    width: 100%;
    max-width: 140px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 8px;
    display: block;
    background: var(--border);
    margin: 0 auto 0.5rem;
  }
  .deal-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    width: 100%;
  }
  .deal-head h3 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .platform {
    font-size: 0.7rem;
    color: var(--muted);
    background: #eef1f4;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0.4rem 0;
  }
  .price {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
  }
  .regular {
    color: var(--muted);
    text-decoration: line-through;
    font-size: 0.95rem;
  }
  .savings {
    color: #ffb454;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .note {
    color: var(--muted);
    font-size: 0.78rem;
    margin: 0.2rem 0 0.6rem;
    line-height: 1.4;
  }
  .checked {
    color: var(--muted);
    font-size: 0.68rem;
    margin: 0.5rem 0 0;
  }
</style>
