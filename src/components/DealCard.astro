---
/**
 * DealCard —— 首页 / 列表页用的「优惠卡片」。
 * 数据来自 src/data/deals.json，渲染时统一走 AffiliateLink 拼接追踪链接。
 */
import AffiliateLink from "./AffiliateLink.astro";
import type { Network } from "../config";

interface Deal {
  id: string;
  title: string;
  platform: string;
  network: Network;
  storeUrl: string;
  note: string;
  lastChecked: string;
  tags?: string[];
  image?: string;
  price?: number;
  originalPrice?: number;
}

const { deal } = Astro.props as { deal: Deal };
const storeName =
  deal.network === "amazon"
    ? "Amazon"
    : deal.network === "gmg"
      ? "Green Man Gaming"
      : deal.network === "humble"
        ? "Humble Bundle"
        : "Fanatical";
const cover = deal.image ? deal.image : `/covers/${deal.id}.svg`;
const tags = (deal.tags || []).join(" ");

const isAmazon = deal.network === "amazon";
const cur = deal.price ?? undefined;
const orig = deal.originalPrice;
const showPrice = cur !== undefined || orig !== undefined;
// 亚马逊不展示具体抓取价：只给 MSRP 作参考价，并提示去官网查实时价
const savingsPct =
  !isAmazon && cur !== undefined && orig !== undefined && cur < orig
    ? Math.round((1 - cur / orig) * 100)
    : null;
const priceMain = isAmazon
  ? orig !== undefined
    ? `List: $${orig.toFixed(2)}`
    : ""
  : cur !== undefined
    ? `$${cur.toFixed(2)}`
    : orig !== undefined
      ? `MSRP $${orig.toFixed(2)}`
      : "";
---

<article class="deal-card" data-title={deal.title} data-platform={deal.platform} data-tags={tags}>
  <img class="cover" src={cover} alt={deal.title} width="140" height="187" loading="lazy" />
  <div class="deal-head">
    <h3>{deal.title}</h3>
    <span class="platform">{deal.platform}</span>
  </div>
  {
    showPrice && (
      <div class="price-row">
        <span class="price">{priceMain}</span>
        {!isAmazon && cur !== undefined && orig !== undefined && orig !== cur && (
          <span class="regular">${orig.toFixed(2)}</span>
        )}
        {savingsPct !== null && <span class="savings">Save {savingsPct}%</span>}
      </div>
    )
  }
  <p class="note">{deal.note}</p>
  <AffiliateLink
    network={deal.network}
    href={deal.storeUrl}
    cta={isAmazon ? "Check price on Amazon" : `View on ${storeName}`}
  />
  <p class="checked">
    {isAmazon
      ? "Price varies on Amazon — tap to see the current deal."
      : `Last checked: ${deal.lastChecked} — verify price on store.`}
  </p>
</article>

<style>
  .deal-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.3rem;
  }
  .cover {
    width: 100%;
    max-width: 140px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 8px;
    display: block;
    background: var(--border);
    margin: 0 auto 0.5rem;
  }
  .deal-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    width: 100%;
  }
  .deal-head h3 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .platform {
    font-size: 0.7rem;
    color: var(--muted);
    background: #eef1f4;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .price-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.3rem 0;
  }
  .price {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
  }
  .regular {
    color: var(--muted);
    text-decoration: line-through;
    font-size: 0.8rem;
  }
  .savings {
    color: #e07b00;
    font-weight: 700;
    font-size: 0.72rem;
    background: #fff3e0;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
  }
  .note {
    color: var(--muted);
    font-size: 0.78rem;
    margin: 0.2rem 0 0.6rem;
    line-height: 1.4;
  }
  .checked {
    color: var(--muted);
    font-size: 0.68rem;
    margin: 0.5rem 0 0;
  }
</style>
