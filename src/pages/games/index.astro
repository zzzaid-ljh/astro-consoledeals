<BaseLayout
  title="Game Guides — ConsoleDeals"
  description="Buying guides and deal analysis for popular console games across Switch, PlayStation, and Xbox."
>
  <h1>Game Guides</h1>
  <p class="sub">
    Long-tail buying guides. Each one ends with the cheapest verified place to
    buy right now.
  </p>
  <ul class="guide-list">
    {
      guides.map((g) => (
        <li>
          <a href={`/games/${g.slug}/`}>{g.title}</a>
          <span class="tag">{g.platform}</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .sub {
    color: var(--muted);
  }
  .guide-list {
    list-style: none;
    padding: 0;
  }
  .guide-list li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }
  .tag {
    font-size: 0.75rem;
    color: var(--muted);
    background: #eef1f4;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    margin-left: 0.5rem;
  }
</style>
