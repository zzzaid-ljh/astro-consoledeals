---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { SITE_URL, GA4_ID } from "../config";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "ConsoleDeals — Console & Game Deals",
  description = "Curated console game deals across Amazon, Green Man Gaming, Humble Bundle, and Fanatical.",
  ogImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImg = ogImage
  ? new URL(ogImage, SITE_URL).toString()
  : new URL("/og-default.svg", SITE_URL).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "ConsoleDeals",
      url: SITE_URL,
      logo: new URL("/favicon.svg", SITE_URL).toString(),
    },
    { "@type": "WebSite", name: "ConsoleDeals", url: SITE_URL, description: description },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="impact-site-verification" content="9bc3966e-e398-4fd4-bb88-0091d2d8a4d7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ConsoleDeals" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImg} />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />

    <!-- JSON-LD 结构化数据 -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <!-- Google Analytics 4（在 src/config.ts 填入 GA4_ID 后自动启用） -->
    {
      GA4_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} is:inline></script>
          <script is:inline define:vars={{ GA4_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', GA4_ID);
          </script>
        </>
      )
    }
  </head>
  <body>
    <Header />
    <main class="container main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
