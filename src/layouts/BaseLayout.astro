---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ConsoleDeals — Console & Game Deals",
  description = "Curated console game deals across Amazon, Green Man Gaming, Humble Bundle, and Fanatical.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="impact-site-verification" content="9bc3966e-e398-4fd4-bb88-0091d2d8a4d7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main class="container main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
